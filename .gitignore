# Variables de entorno y configuraciones sensibles
.env
.env.local
.env.*.local
*.config.php
config/database.local.php
clave_acceso.txt

# Dependencias
/vendor/
/node_modules/

# IDE
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Sistema Operativo
.DS_Store
Thumbs.db
desktop.ini

# Logs
/logs/*.log
*.log

# Backups de BD y dumps
/backups/*.sql
/backups/*.zip
*.sql
*.sqlite
*.db
tiendaropa_base_datos.txt
*_base_datos.txt

# Cache y temporales
/cache/
/tmp/
*.cache
*.tmp

